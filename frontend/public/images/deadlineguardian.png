<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgD" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090514" />
      <stop offset="100%" stop-color="#190e38" />
    </linearGradient>
    <linearGradient id="purpGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#8b5cf6" />
      <stop offset="100%" stop-color="#ec4899" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgD)" />
  
  <!-- Central Productivity Clock / Dial -->
  <circle cx="280" cy="240" r="140" fill="none" stroke="#2e1065" stroke-width="16" />
  <circle cx="280" cy="240" r="140" fill="none" stroke="url(#purpGrad)" stroke-width="16" stroke-dasharray="620" stroke-dashoffset="180" stroke-linecap="round" />
  
  <text x="280" y="230" fill="#f3e8ff" font-family="sans-serif" font-size="44" font-weight="800" text-anchor="middle">94%</text>
  <text x="280" y="265" fill="#c084fc" font-family="sans-serif" font-size="14" font-weight="600" text-anchor="middle" letter-spacing="1">ON-TRACK VELOCITY</text>

  <!-- Prioritization Pipeline Cards on Right -->
  <g transform="translate(480, 100)">
    <!-- Task 1 (High Priority AI) -->
    <rect x="0" y="0" width="260" height="70" rx="10" fill="rgba(30, 27, 75, 0.85)" stroke="#a855f7" stroke-width="1.5" />
    <circle cx="24" cy="35" r="8" fill="#ef4444" />
    <text x="44" y="32" fill="#faf5ff" font-family="sans-serif" font-size="14" font-weight="bold">AI Model Deployment</text>
    <text x="44" y="52" fill="#c084fc" font-family="sans-serif" font-size="12">Score: 98/100 • Critical Path</text>
    
    <!-- Task 2 (Medium) -->
    <rect x="0" y="90" width="260" height="70" rx="10" fill="rgba(30, 27, 75, 0.85)" stroke="#8b5cf6" stroke-width="1.2" />
    <circle cx="24" cy="125" r="8" fill="#f59e0b" />
    <text x="44" y="122" fill="#faf5ff" font-family="sans-serif" font-size="14" font-weight="bold">Sprint Refinement</text>
    <text x="44" y="142" fill="#c084fc" font-family="sans-serif" font-size="12">Score: 76/100 • Scheduled</text>

    <!-- Task 3 (Completed) -->
    <rect x="0" y="180" width="260" height="70" rx="10" fill="rgba(30, 27, 75, 0.85)" stroke="#4c1d95" stroke-width="1" />
    <circle cx="24" cy="215" r="8" fill="#10b981" />
    <text x="44" y="212" fill="#cbd5e1" font-family="sans-serif" font-size="14" font-weight="bold">Dataset Curation</text>
    <text x="44" y="232" fill="#10b981" font-family="sans-serif" font-size="12">Completed On-Time</text>
  </g>
  
  <!-- Neural Scheduling Graph Nodes at Bottom Left -->
  <line x1="120" y1="410" x2="220" y2="430" stroke="#8b5cf6" stroke-width="2" />
  <line x1="220" y1="430" x2="340" y2="400" stroke="#8b5cf6" stroke-width="2" />
  <line x1="340" y1="400" x2="440" y2="430" stroke="#8b5cf6" stroke-width="2" />
  <circle cx="120" cy="410" r="6" fill="#c084fc" />
  <circle cx="220" cy="430" r="6" fill="#c084fc" />
  <circle cx="340" cy="400" r="6" fill="#c084fc" />
  <circle cx="440" cy="430" r="6" fill="#c084fc" />
  <text x="280" y="470" fill="#a78bfa" font-family="sans-serif" font-size="13" font-weight="600" text-anchor="middle">Automated Adaptive Scheduling Engine</text>
</svg>