<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgW" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#02141a" />
      <stop offset="100%" stop-color="#072b38" />
    </linearGradient>
    <linearGradient id="chartGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.0" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgW)" />
  
  <!-- Cricket Pitch / Pitch Map Graphic -->
  <rect x="80" y="80" width="180" height="280" rx="8" fill="#04202c" stroke="#0891b2" stroke-width="2" />
  <line x1="80" y1="130" x2="260" y2="130" stroke="#06b6d4" stroke-width="2" stroke-dasharray="4 4" />
  <line x1="80" y1="310" x2="260" y2="310" stroke="#06b6d4" stroke-width="2" stroke-dasharray="4 4" />
  <circle cx="170" cy="180" r="7" fill="#ef4444" />
  <circle cx="150" cy="220" r="7" fill="#22c55e" />
  <circle cx="190" cy="260" r="7" fill="#3b82f6" />
  <text x="170" y="345" fill="#67e8f9" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">PITCH HEATMAP</text>

  <!-- Prediction Graph / Curve on Right -->
  <g transform="translate(320, 80)">
    <rect x="0" y="0" width="410" height="280" rx="10" fill="#031d27" stroke="#0e7490" stroke-width="1.5" />
    
    <!-- Grid -->
    <line x1="40" y1="60" x2="380" y2="60" stroke="#083344" stroke-width="1" />
    <line x1="40" y1="120" x2="380" y2="120" stroke="#083344" stroke-width="1" />
    <line x1="40" y1="180" x2="380" y2="180" stroke="#083344" stroke-width="1" />
    <line x1="40" y1="240" x2="380" y2="240" stroke="#083344" stroke-width="1" />

    <!-- Area Fill -->
    <path d="M 40 220 Q 120 180, 200 130 T 380 70 L 380 240 L 40 240 Z" fill="url(#chartGrad)" />
    <!-- Line -->
    <path d="M 40 220 Q 120 180, 200 130 T 380 70" fill="none" stroke="#22d3ee" stroke-width="3.5" />
    
    <circle cx="380" cy="70" r="6" fill="#38bdf8" />
    <text x="350" y="55" fill="#38bdf8" font-family="sans-serif" font-size="13" font-weight="bold">Win Prob: 78.5%</text>
    <text x="40" y="35" fill="#e0f2fe" font-family="sans-serif" font-size="14" font-weight="bold">Live Match Prediction Trajectory</text>
  </g>

  <!-- Metric Badges Bottom -->
  <g transform="translate(80, 400)">
    <rect x="0" y="0" width="650" height="60" rx="10" fill="rgba(3, 30, 40, 0.8)" stroke="#0e7490" stroke-width="1" />
    <text x="40" y="35" fill="#94a3b8" font-family="sans-serif" font-size="14">Dataset: <tspan fill="#38bdf8" font-weight="bold">ICC Historical (2000-2024)</tspan></text>
    <text x="320" y="35" fill="#94a3b8" font-family="sans-serif" font-size="14">Algorithm: <tspan fill="#22c55e" font-weight="bold">Random Forest + XGBoost</tspan></text>
    <text x="560" y="35" fill="#a5f3fc" font-family="sans-serif" font-size="14" font-weight="bold">Render Live</text>
  </g>
</svg>