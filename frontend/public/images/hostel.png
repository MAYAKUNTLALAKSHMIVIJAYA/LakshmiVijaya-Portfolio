<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgH" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#140a04" />
      <stop offset="100%" stop-color="#2a1506" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgH)" />
  
  <!-- Architectural Matrix Grid -->
  <g transform="translate(100, 100)">
    <!-- Room Grid -->
    <rect x="0" y="0" width="280" height="260" rx="10" fill="#1f1106" stroke="#f59e0b" stroke-width="1.5" />
    <text x="140" y="35" fill="#fef3c7" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">Room Allocation Grid</text>
    
    <!-- Matrix Cells -->
    <rect x="30" y="60" width="60" height="45" rx="6" fill="#10b981" />
    <text x="60" y="87" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R101</text>
    <rect x="110" y="60" width="60" height="45" rx="6" fill="#ef4444" />
    <text x="140" y="87" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R102</text>
    <rect x="190" y="60" width="60" height="45" rx="6" fill="#10b981" />
    <text x="220" y="87" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R103</text>

    <rect x="30" y="125" width="60" height="45" rx="6" fill="#ef4444" />
    <text x="60" y="152" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R201</text>
    <rect x="110" y="125" width="60" height="45" rx="6" fill="#10b981" />
    <text x="140" y="152" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R202</text>
    <rect x="190" y="125" width="60" height="45" rx="6" fill="#10b981" />
    <text x="220" y="152" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R203</text>

    <rect x="30" y="190" width="60" height="45" rx="6" fill="#10b981" />
    <text x="60" y="217" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R301</text>
    <rect x="110" y="190" width="60" height="45" rx="6" fill="#ef4444" />
    <text x="140" y="217" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R302</text>
    <rect x="190" y="190" width="60" height="45" rx="6" fill="#10b981" />
    <text x="220" y="217" fill="#ffffff" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">R303</text>
  </g>

  <!-- Administrative Controls Panel on Right -->
  <g transform="translate(420, 100)">
    <rect x="0" y="0" width="280" height="260" rx="10" fill="#1f1106" stroke="#f59e0b" stroke-width="1.5" />
    <text x="140" y="35" fill="#fef3c7" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">Authentication &amp; CRUD</text>
    
    <rect x="25" y="60" width="230" height="40" rx="6" fill="#2d1a0b" />
    <text x="45" y="85" fill="#fde68a" font-family="sans-serif" font-size="13">Student Verification: Passed</text>
    
    <rect x="25" y="115" width="230" height="40" rx="6" fill="#2d1a0b" />
    <text x="45" y="140" fill="#fde68a" font-family="sans-serif" font-size="13">Room Capacity: 84% Occupied</text>

    <rect x="25" y="170" width="230" height="50" rx="6" fill="#3d2310" stroke="#b45309" />
    <text x="140" y="200" fill="#fbbf24" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">MySQL Relational DB</text>
  </g>

  <text x="400" y="420" fill="#fcd34d" font-family="sans-serif" font-size="15" font-weight="600" text-anchor="middle">
    PHP Backend • Role-Based Access Control • Automated Room Allocation
  </text>
</svg>