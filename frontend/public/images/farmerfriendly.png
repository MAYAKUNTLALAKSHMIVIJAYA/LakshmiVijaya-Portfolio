<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgF" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#021a11" />
      <stop offset="100%" stop-color="#063222" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgF)" />
  
  <!-- Direct Marketplace Architecture Graphic -->
  <!-- Farmer Node -->
  <rect x="90" y="160" width="180" height="150" rx="12" fill="#042c1e" stroke="#10b981" stroke-width="2" />
  <circle cx="180" cy="210" r="28" fill="#059669" opacity="0.3" />
  <text x="180" y="215" fill="#34d399" font-family="sans-serif" font-size="24" text-anchor="middle">🌱</text>
  <text x="180" y="260" fill="#f0fdf4" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">Farmer Portal</text>
  <text x="180" y="285" fill="#86efac" font-family="sans-serif" font-size="12" text-anchor="middle">Direct Produce Listing</text>

  <!-- Spring Boot / MySQL Hub Center -->
  <circle cx="400" cy="235" r="70" fill="#022117" stroke="#10b981" stroke-width="2.5" />
  <text x="400" y="225" fill="#6ee7b7" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">Spring Boot API</text>
  <text x="400" y="248" fill="#a7f3d0" font-family="monospace" font-size="12" text-anchor="middle">MySQL Relational</text>

  <!-- Consumer Node -->
  <rect x="530" y="160" width="180" height="150" rx="12" fill="#042c1e" stroke="#10b981" stroke-width="2" />
  <circle cx="620" cy="210" r="28" fill="#059669" opacity="0.3" />
  <text x="620" y="215" fill="#34d399" font-family="sans-serif" font-size="24" text-anchor="middle">🛒</text>
  <text x="620" y="260" fill="#f0fdf4" font-family="sans-serif" font-size="16" font-weight="bold" text-anchor="middle">Consumer Hub</text>
  <text x="620" y="285" fill="#86efac" font-family="sans-serif" font-size="12" text-anchor="middle">Transparent Pricing</text>

  <!-- Connecting Data Flow Arrows -->
  <line x1="270" y1="235" x2="330" y2="235" stroke="#34d399" stroke-width="3" stroke-dasharray="6 4" />
  <line x1="470" y1="235" x2="530" y2="235" stroke="#34d399" stroke-width="3" stroke-dasharray="6 4" />
  
  <text x="400" y="380" fill="#a7f3d0" font-family="sans-serif" font-size="15" font-weight="600" text-anchor="middle">
    Full-Stack Farm-to-Consumer Ecosystem • Zero Middlemen
  </text>
</svg>