<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgK" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#030712" />
      <stop offset="100%" stop-color="#0c162d" />
    </linearGradient>
    <linearGradient id="cyanB" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="100%" stop-color="#3b82f6" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgK)" />
  
  <!-- Shelf Rack Structure -->
  <line x1="80" y1="180" x2="720" y2="180" stroke="#334155" stroke-width="8" stroke-linecap="round" />
  <line x1="80" y1="340" x2="720" y2="340" stroke="#334155" stroke-width="8" stroke-linecap="round" />
  
  <!-- Products on Shelf -->
  <!-- Product 1: Detected Box with Bounding Box & OCR -->
  <rect x="130" y="70" width="90" height="110" rx="6" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5" />
  <rect x="122" y="62" width="106" height="126" rx="8" fill="none" stroke="#22d3ee" stroke-width="2.5" stroke-dasharray="8 6" />
  <rect x="122" y="38" width="106" height="22" rx="4" fill="#06b6d4" />
  <text x="175" y="53" fill="#020617" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">SKU_01 98.4%</text>

  <!-- Product 2 -->
  <rect x="260" y="90" width="80" height="90" rx="6" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5" />
  <rect x="254" y="84" width="92" height="102" rx="8" fill="none" stroke="#22d3ee" stroke-width="2.5" stroke-dasharray="8 6" />
  <rect x="254" y="62" width="92" height="20" rx="4" fill="#06b6d4" />
  <text x="300" y="76" fill="#020617" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">SKU_02 96.1%</text>

  <!-- Product 3: Empty Slot / Alert -->
  <rect x="390" y="80" width="110" height="100" rx="6" fill="rgba(239, 68, 68, 0.08)" stroke="#ef4444" stroke-width="2" stroke-dasharray="6 4" />
  <text x="445" y="135" fill="#f87171" font-family="monospace" font-size="13" font-weight="bold" text-anchor="middle">[RESTOCK NEEDED]</text>

  <!-- Product 4 -->
  <rect x="540" y="60" width="100" height="120" rx="6" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5" />
  <rect x="532" y="52" width="116" height="136" rx="8" fill="none" stroke="#22d3ee" stroke-width="2.5" stroke-dasharray="8 6" />
  <rect x="532" y="28" width="116" height="22" rx="4" fill="#06b6d4" />
  <text x="590" y="43" fill="#020617" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">SKU_04 99.2%</text>

  <!-- Lower Shelf Products -->
  <rect x="140" y="230" width="110" height="110" rx="6" fill="#1e293b" stroke="#64748b" />
  <rect x="290" y="220" width="120" height="120" rx="6" fill="#1e293b" stroke="#64748b" />
  <rect x="450" y="240" width="100" height="100" rx="6" fill="#1e293b" stroke="#64748b" />
  <rect x="590" y="210" width="90" height="130" rx="6" fill="#1e293b" stroke="#64748b" />

  <!-- Scanning Reticle Line -->
  <line x1="80" y1="200" x2="720" y2="200" stroke="#38bdf8" stroke-width="3" opacity="0.85" />
  
  <!-- HUD Bottom Bar -->
  <rect x="80" y="390" width="640" height="70" rx="12" fill="rgba(15, 23, 42, 0.85)" stroke="#3b82f6" stroke-width="1.5" />
  <text x="120" y="432" fill="#38bdf8" font-family="sans-serif" font-weight="bold" font-size="15">KiranaSightAI Vision HUD</text>
  <text x="360" y="432" fill="#94a3b8" font-family="sans-serif" font-size="14">Items Tracked: <tspan fill="#4ade80" font-weight="bold">42/48</tspan></text>
  <text x="560" y="432" fill="#94a3b8" font-family="sans-serif" font-size="14">OCR Confidence: <tspan fill="#38bdf8" font-weight="bold">97.8%</tspan></text>
</svg>